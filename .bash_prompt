__starship_prompt() {
    # Catch errors
    local exit_code=$?

    # Colors
    local RESET='\[\e[0m\]'
    local RED='\[\e[1;31m\]'
    local GREEN='\[\e[1;32m\]'
    local YELLOW='\[\e[1;33m\]'
    local PURPLE='\[\e[1;35m\]'
    local CYAN='\[\e[1;36m\]'

    # Directory module
    local dir="${CYAN}\w${RESET}"

    # Git module
    local git_info=""

    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch=$(git branch --show-current 2>/dev/null)

	local modified=""
	if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
	    modified="${RED}*[!+]${RESET}"
	fi

	git_info=" in ${PURPLE} ${branch}${RESET}${modified}"
    fi

    # node module
    local node_info=""
    if [ -f "package.json" ]; then
        if command -v node >/dev/null 2>&1; then
            local node_version=$(node -v 2>/dev/null)
	    node_info=" via ${GREEN} ${node_version}${RESET}"
	fi
    fi

    # Prompt char
    local prompt_char="${GREEN}\$${RESET}"
    if [ $exit_code -ne 0 ]; then
        prompt_char="${RED}\$${RESET}"
    fi

    # The prompt itself
    PS1="\n${dir}${git_info}${node_info}\n${prompt_char} "
}

PROMPT_COMMAND=__starship_prompt
